// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
}

enum Provider {
  local
  google
}

enum Frequency {
  daily
  weekly
  biweekly
  monthly
  yearly
}

enum IncomeSource {
  salary
  freelance
  rental
  business
  other
}

enum AssetType {
  cash
  property
  stocks
  vehicle
  other
}

enum LiabilityType {
  loan
  credit_card
  mortgage
  other
}

enum GlucoseMeasurementType {
  fasting
  post_meal
  random
  bedtime
}

model User {
  id Int @id @default(autoincrement())
  first_name String
  last_name String
  email String @unique
  password String?
  gender Gender?
  avatar String?
  provider Provider
  providerId String?
  height Decimal? @db.Decimal
  is_deleted Boolean @default(false)
  created_at DateTime @default(now())
  last_login_at DateTime?

  healthTrackers     HealthTracker[]
  bloodPressures     BloodPressure[]
  bloodGlucoses      BloodGlucose[]
  expenseTrackers    ExpenseTracker[]
  recurringExpenses  RecurringExpense[]
  recurringIncomes   RecurringIncome[]
  incomes            Income[]
  budgetLimits       BudgetLimit[]
  financialGoals     FinancialGoal[]
  assets             Asset[]
  liabilities        Liability[]
}

model HealthTracker {
  id Int @id @default(autoincrement())
  weight        Decimal @db.Decimal
  waist         Decimal @db.Decimal
  neck          Decimal @db.Decimal
  bmi           Decimal @db.Decimal
  bodyFat       Decimal @db.Decimal
  bodyFatWeight Decimal @db.Decimal
  userId        Int
  user          User @relation(fields: [userId], references: [id])
  created_at    DateTime @default(now())
}


model ExpenseTracker {
  id                  Int               @id @default(autoincrement())
  date                DateTime
  expense_title       String
  amount              Decimal           @db.Decimal
  categoryId          Int
  category            Category          @relation(fields: [categoryId], references: [id])
  userId              Int
  user                User              @relation(fields: [userId], references: [id])
  recurringExpenseId  Int?
  recurringExpense    RecurringExpense?  @relation(fields: [recurringExpenseId], references: [id])
  created_at          DateTime          @default(now())
}

model RecurringExpense {
  id             Int              @id @default(autoincrement())
  expense_title  String
  amount         Decimal          @db.Decimal
  frequency      Frequency
  start_date     DateTime
  end_date       DateTime?
  next_run_date  DateTime
  last_run_date  DateTime?
  is_active      Boolean          @default(true)
  categoryId     Int
  category       Category         @relation(fields: [categoryId], references: [id])
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  created_at     DateTime         @default(now())
  expenseTrackers ExpenseTracker[]
}


model Category {
  id                 Int                @id @default(autoincrement())
  title              String             @unique
  created_at         DateTime           @default(now())

  expense_trackers   ExpenseTracker[]
  recurringExpenses  RecurringExpense[]
  budgetLimits       BudgetLimit[]
}

model RecurringIncome {
  id             Int          @id @default(autoincrement())
  title          String
  amount         Decimal      @db.Decimal
  source         IncomeSource
  frequency      Frequency
  start_date     DateTime
  end_date       DateTime?
  next_run_date  DateTime
  last_run_date  DateTime?
  is_active      Boolean      @default(true)
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  created_at     DateTime     @default(now())
  incomes        Income[]
}

model Income {
  id                Int              @id @default(autoincrement())
  date              DateTime
  title             String
  amount            Decimal          @db.Decimal
  source            IncomeSource
  userId            Int
  user              User             @relation(fields: [userId], references: [id])
  recurringIncomeId Int?
  recurringIncome   RecurringIncome? @relation(fields: [recurringIncomeId], references: [id])
  created_at        DateTime         @default(now())
}

model BudgetLimit {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  amount     Decimal  @db.Decimal
  created_at DateTime @default(now())

  @@unique([userId, categoryId])
}

model FinancialGoal {
  id            Int      @id @default(autoincrement())
  title         String
  target_amount Decimal  @db.Decimal
  target_date   DateTime
  is_achieved   Boolean  @default(false)
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  created_at    DateTime @default(now())
}

model Asset {
  id         Int       @id @default(autoincrement())
  title      String
  value      Decimal   @db.Decimal
  type       AssetType
  date       DateTime
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  created_at DateTime  @default(now())
}

model BloodPressure {
  id          Int      @id @default(autoincrement())
  systolic    Int
  diastolic   Int
  pulse       Int?
  notes       String?
  measured_at DateTime
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  created_at  DateTime @default(now())
}

model BloodGlucose {
  id               Int                    @id @default(autoincrement())
  glucose_level    Decimal                @db.Decimal
  measurement_type GlucoseMeasurementType
  notes            String?
  measured_at      DateTime
  userId           Int
  user             User                   @relation(fields: [userId], references: [id])
  created_at       DateTime               @default(now())
}

model Liability {
  id         Int           @id @default(autoincrement())
  title      String
  amount     Decimal       @db.Decimal
  type       LiabilityType
  userId     Int
  user       User          @relation(fields: [userId], references: [id])
  created_at DateTime      @default(now())
}